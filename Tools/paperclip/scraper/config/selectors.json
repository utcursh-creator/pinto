{
  "version": "2026-04",
  "_note": "Each field is a fallback chain — extractor uses first matching selector. Add new selectors to the TOP of the chain when LinkedIn DOM changes.",
  "post": {
    "container": [
      "div[data-urn^='urn:li:activity:']",
      "div[data-view-name='feed-full-update']",
      "div.feed-shared-update-v2",
      "article[data-urn^='urn:li:activity:']"
    ],
    "author_name": [
